{
  "name": "pi-windows-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Native Windows desktop shell for the Pi coding agent.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "test": "npm run test:pi && npm run test:session && npm run test:conversation && npm run test:workspace && npm run test:shell && npm run test:wsl",
    "test:pi": "node --test --experimental-strip-types src/main/services/pi/__tests__/pi-rpc-client.test.mjs src/main/services/pi/wsl-process-transport.test.ts src/main/services/pi/pi-runtime.test.ts src/main/services/pi/pi-rpc-contract.test.ts",
    "test:session": "node --test --experimental-strip-types src/main/services/session/session-manager.test.ts src/main/services/session/session-store.test.ts",
    "test:conversation": "node --test --experimental-strip-types src/main/services/conversation/index.test.ts",
    "test:workspace": "node --test --experimental-strip-types src/main/services/workspace/workspace-file.test.ts src/main/services/workspace/workspace-git.test.ts src/main/services/workspace/ipc-mapping.test.ts",
    "test:shell": "node --test --experimental-strip-types src/shared/ipc.test.ts src/shared/host-port.test.ts",
    "test:wsl": "node --test --experimental-strip-types src/main/wsl/index.test.ts",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.5"
  },
  "engines": {
    "node": ">=20"
  }
}
